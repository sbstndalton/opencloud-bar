# Headless mode (servers, no tray): systemctl --user enable --now opencloud-bar
[Unit]
Description=OpenCloud Bar (headless): two-way sync of kept folders with OpenCloud
After=network-online.target

[Service]
ExecStart=/usr/bin/opencloud-bar run --no-tray
Restart=on-failure
RestartSec=30
KillSignal=SIGTERM
TimeoutStopSec=180
# No MemoryMax: rclone's memory grows with the size of the kept folders (bisync holds the
# listings in memory) and with the drive's transfers. A hard limit made systemd kill the whole
# service mid-sync or mid-upload; bisync then needs a recovery run and drive uploads restart.

[Install]
WantedBy=default.target
