[Unit]
Description=OpenCloud Bar (headless): two-way sync of kept folders with OpenCloud
After=network-online.target docker.service

[Service]
ExecStart=%h/bin/opencloud-bar run --no-tray
Restart=on-failure
RestartSec=30
KillSignal=SIGTERM
TimeoutStopSec=180
# No MemoryMax on this service: the app itself is small, and a limit here would also cover
# rclone (bisync holds the listings in memory), so systemd would kill the whole service
# mid-sync. On this server rclone runs in Docker instead (see rclone-docker), and that
# container is capped at 3 GB: the memory cap lives there.

[Install]
WantedBy=default.target
