[Unit]
Description=OpenCloud Bar (headless): two-way sync of kept folders with OpenCloud
After=network-online.target docker.service

[Service]
ExecStart=%h/bin/opencloud-bar run --no-tray
Restart=on-failure
RestartSec=30
KillSignal=SIGTERM
TimeoutStopSec=180
# No MemoryMax: rclone's memory grows with the size of the kept folders (bisync holds the
# listings in memory). A hard limit made systemd kill the service mid-sync; see
# packaging/linux/opencloud-bar.service.

[Install]
WantedBy=default.target
